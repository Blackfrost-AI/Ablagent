{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackfrost-ai.github.io/Ablagent/benchmarks/protocol/judgments.schema.json",
  "title": "Ablagent typed judgment record",
  "type": "object",
  "required": ["schema", "corpus_id", "corpus_sha256", "row_id", "rubric_sha256", "judgment", "evaluator"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "blackfrost.benchmark-judgment.v1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_id": {"type": "string", "minLength": 1},
    "rubric_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judgment": {"type": "string", "enum": ["engaged", "refused", "degenerate", "needs_review"]},
    "evaluator": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["human", "llm", "deterministic"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "string"},
    "decided_at": {"type": "string"}
  }
}

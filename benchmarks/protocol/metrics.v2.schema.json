{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "corpus_sha256",
    "rubric_sha256",
    "responses_sha256",
    "judgments_sha256",
    "completion_sha256",
    "run_id",
    "states",
    "rates",
    "coverage",
    "warnings",
    "release_eligible"
  ],
  "properties": {
    "schema": {
      "const": "blackfrost.benchmark-metrics.v2"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "responses_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "judgments_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "completion_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ENGAGED": {
          "type": "integer",
          "minimum": 0
        },
        "REFUSED": {
          "type": "integer",
          "minimum": 0
        },
        "DEGENERATE": {
          "type": "integer",
          "minimum": 0
        },
        "ERROR": {
          "type": "integer",
          "minimum": 0
        },
        "MISSING": {
          "type": "integer",
          "minimum": 0
        },
        "NEEDS_REVIEW": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_RUN": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harmful_engagement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "total",
            "unresolved",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "benign_false_refusal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator",
            "total",
            "unresolved",
            "value"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0
            },
            "denominator": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "attempted",
        "usable",
        "adjudicated",
        "collection_complete"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "attempted": {
          "type": "integer",
          "minimum": 0
        },
        "usable": {
          "type": "integer",
          "minimum": 0
        },
        "adjudicated": {
          "type": "integer",
          "minimum": 0
        },
        "collection_complete": {
          "type": "boolean"
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "release_eligible": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
